@page "/projects"

@inject IAutomationProjectStore ProjectStore
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">\n    @if (!string.IsNullOrWhiteSpace(_error))\n    {\n        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>\n    }
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h2">Projects</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Automation projects stored locally by the host.</MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/">
                New project
            </MudButton>
        </MudStack>

        @if (_projects.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No projects have been created yet.</MudAlert>
        }
        else
        {
            @foreach (var project in _projects)
            {
                <MudPaper Class="pa-4" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">@project.Name</MudText>
                            <MudText Typo="Typo.caption">@project.DirectoryName</MudText>
                            @if (!project.IsValid)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">
                                    Invalid project: @string.Join(" ", project.ValidationErrors)
                                </MudText>
                            }
                        </div>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Color="Color.Primary"
                                       Disabled="@(project.Id == Guid.Empty)"
                                       OnClick="@(() => Navigation.NavigateTo($"/editor/{project.Id:D}"))">
                                @(project.IsValid ? "Open" : "Resolve")
                            </MudButton>
                            @if (!project.IsValid && project.Id == Guid.Empty)
                            {
                                <MudButton Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Build"
                                           OnClick="@(() => RepairProjectAsync(project))">
                                    Repair
                                </MudButton>
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           OnClick="@(() => ConfirmDelete(project))" />
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudStack>
</MudContainer>

<MudDialog @bind-Visible="_showDeleteDialog">
    <DialogContent>
        <MudText Typo="Typo.h6">Delete project?</MudText>
        <MudText Typo="Typo.body2">
            This permanently deletes <strong>@_projectToDelete?.Name</strong> and all automation artifacts.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDeleteDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteProjectAsync">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AutomationProjectInfo> _projects = [];
    private AutomationProjectInfo? _projectToDelete;
    private bool _showDeleteDialog;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
    }

    private async Task LoadProjectsAsync() =>
        _projects = [.. await ProjectStore.ListAsync()];

    private void ConfirmDelete(AutomationProjectInfo project)
    {
        _projectToDelete = project;
        _showDeleteDialog = true;
    }

    private async Task DeleteProjectAsync()
    {
        if (_projectToDelete is null)
            return;

        var project = _projectToDelete;
        _showDeleteDialog = false;
        _projectToDelete = null;

        try
        {
            await ProjectStore.DeleteAsync(project);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task RepairProjectAsync(AutomationProjectInfo project)
    {
        try
        {
            await ProjectStore.RepairAsync(project);
            await LoadProjectsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Unable to repair project: {ex.Message}";
        }
    }
}
