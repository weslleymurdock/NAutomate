@page "/projects"

@inject IAutomationProjectStore ProjectStore
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h2">Projects</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Automation projects stored locally by the host.</MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/">
                New project
            </MudButton>
        </MudStack>

        @if (_projects.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No projects have been created yet.</MudAlert>
        }
        else
        {
            @foreach (var project in _projects)
            {
                <MudPaper Class="pa-4" Outlined="true">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.h6">@project.Name</MudText>
                            <MudText Typo="Typo.caption">@project.DirectoryName</MudText>
                            @if (!project.IsValid)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error">
                                    Invalid project: @string.Join(" ", project.ValidationErrors)
                                </MudText>
                            }
                        </div>
                        <MudButton Color="Color.Primary"
                                   Disabled="@(project.Id == Guid.Empty)"
                                   OnClick="@(() => Navigation.NavigateTo($"/editor/{project.Id:D}"))">
                            Open
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudStack>
</MudContainer>

@code {
    private List<AutomationProjectInfo> _projects = [];

    protected override async Task OnInitializedAsync() =>
        _projects = [.. await ProjectStore.ListAsync()];
}
