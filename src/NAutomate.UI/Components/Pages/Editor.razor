@page "/editor"
@using System.Globalization
@using NAutomate.Abstractions
@using NAutomate.Core
@using NAutomate.Parser
@inject IModuleRegistry ModuleRegistry
@inject WorkflowEngine WorkflowEngine
@inject IExecutionEnvironmentService EnvironmentService

<PageTitle>Automation Editor</PageTitle>

<MudStack Spacing="2" Class="editor-shell">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" />
            <div>
                <MudText Typo="Typo.h5">Automation editor / debugger</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@CountSteps(_steps) steps · Entry point cannot be removed</MudText>
            </div>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.BugReport" Disabled="@HasActiveDebugSession" OnClick="DebugAsync">Debug</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Disabled="@(!CanPlay)" OnClick="Play" />
            <MudIconButton Icon="@Icons.Material.Filled.Pause" Color="Color.Warning" Disabled="@(!CanPause)" OnClick="Pause" />
            <MudIconButton Icon="@Icons.Material.Filled.Stop" Color="Color.Error" Disabled="@(!CanStop)" OnClick="StopAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Disabled="@(!CanStep)" OnClick="StepInto" />
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Disabled="@(!CanStep)" OnClick="StepOver" />
            <MudChip T="string" Size="Size.Small" Color="@DebugStatusColor">@DebugStatus</MudChip>
        </MudStack>
    </MudStack>

    <MudPaper Class="editor-toolbar pa-2" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
            <MudChip T="string" Icon="@Icons.Material.Filled.Public" Color="Color.Primary" Size="Size.Small">
                @( _selectedEnvironment?.Name ?? "No environment" )
            </MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_variables.Count variable(s)
            </MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Tune"
                       OnClick="@(() => _showEnvironmentDialog = true)">
                Environment & variables
            </MudButton>
        </MudStack>
    </MudPaper>

    <div class="nautomate-editor">
        <aside class="module-sidebar">
            <MudText Typo="Typo.subtitle1" Class="pa-3">Build workflow</MudText>
            <MudText Typo="Typo.caption" Class="px-3 pb-2" Color="Color.Secondary">
                Drag a control or module to the exact branch where it should execute.
            </MudText>

            <MudStack Spacing="1" Class="pa-2">
                <MudText Typo="Typo.caption">Control flow</MudText>
                                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragIf())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.CallSplit" Disabled="@HasActiveDebugSession" OnClick="@(() => AddIf)">IF / ELSE</MudButton>
                </div>
                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragFor())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Repeat" Disabled="@HasActiveDebugSession" OnClick="@(() => AddFor)">FOR</MudButton>
                </div>
                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragForeach())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Loop" Disabled="@HasActiveDebugSession" OnClick="@(() => AddForeach)">FOREACH</MudButton>
                </div>
                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragWhile())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Sync" Disabled="@HasActiveDebugSession" OnClick="@(() => AddWhile)">WHILE</MudButton>
                </div>
                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragSet())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Edit" Disabled="@HasActiveDebugSession" OnClick="@(() => AddSet)">SET VARIABLE</MudButton>
                </div>
                <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragExit())">
                    <MudButton FullWidth Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.StopCircle" Disabled="@HasActiveDebugSession" OnClick="@(() => AddExit)">EXIT</MudButton>
                </div>

            </MudStack>

            <MudDivider Class="my-2" />
            <MudTextField @bind-Value="_search" Placeholder="Search modules..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="px-3 pb-2" />

            <MudStack Spacing="0">
                @foreach (var module in Modules)
                {
                    <div class="palette-drag" draggable="true" @ondragstart="@(() => BeginDragModule(module.Id))">
                        <MudButton FullWidth="true" Variant="Variant.Text" Class="method-item" StartIcon="@Icons.Material.Filled.Extension" Disabled="@HasActiveDebugSession" OnClick="@(() => AddModule(module))">
                            <span><span class="method-label">@module.DisplayName</span><span class="method-id">@module.Id</span></span>
                        </MudButton>
                    </div>
                }
            </MudStack>
        </aside>

        <main class="flow-canvas workflow-tree-canvas">
            <div class="canvas-toolbar">
                <MudChip T="string" Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary">Workflow</MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Nested blocks are the execution paths.</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Disabled="@HasActiveDebugSession" OnClick="AddEcho">Add Echo</MudButton>
            </div>

            <div class="workflow-tree">
                <div class="workflow-entry">
                    <MudIcon Icon="@Icons.Material.Filled.PlayArrow" />
                    <MudText Typo="Typo.subtitle2">Entrypoint</MudText>
                </div>

                <div class="workflow-dropzone workflow-dropzone-root"
                     @ondragover:preventDefault="true"
                     @ondrop="DropRootAsync">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Size="Size.Small" />
                    <MudText Typo="Typo.caption">Drop a step here to add it to the workflow</MudText>
                </div>

                @foreach (var step in _steps)
                {
                    <EditorFlowStepNode Step="step"
                                        ActiveStepId="@_activeStepId"
                                        Disabled="@HasActiveDebugSession"
                                        OnSelected="SelectStep"
                                        OnRemoved="RemoveStepAsync"
                                        OnAddChild="AddChildAsync"
                                        OnDropChild="DropChildAsync" />
                }
            </div>
        </main>

        <aside class="step-inspector">
            @if (_selected is null)
            {
                <MudStack Class="pa-4" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Step inspector</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Select a step to edit its parameters. Drag new steps from the left palette to the desired branch.</MudText>
                </MudStack>
            }
            else
            {
                <MudStack Class="pa-4" Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@_selected.Icon" />
                        <MudText Typo="Typo.h6">@_selected.Title</MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Disabled="@HasActiveDebugSession" OnClick="@(() => RemoveStepAsync(_selected))" />
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_selected.Description</MudText>
                    <MudDivider />

                    @if (_selected.Kind == WorkflowStepKind.Module)
                    {
                        @foreach (var parameter in _selected.Parameters)
                        {
                            <MudTextField T="string"
                                          Value="@GetParameter(_selected, parameter.Name)"
                                          ValueChanged="@((string? value) => SetParameter(_selected, parameter.Name, value))"
                                          Label="@parameter.Name"
                                          HelperText="@parameter.Description"
                                          Variant="Variant.Outlined"
                                          Disabled="@HasActiveDebugSession" />
                        }
                    }
                    else if (_selected.Kind == WorkflowStepKind.If || _selected.Kind == WorkflowStepKind.While)
                    {
                        <MudSelect T="string" Label="Variable" Value="@GetValue(_selected, "conditionVariable")" ValueChanged="@(value => SetValue(_selected, "conditionVariable", value))" Variant="Variant.Outlined">
                            @foreach (var variable in _variables)
                            {
                                <MudSelectItem T="string" Value="@variable.Name">$@variable.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="WorkflowConditionOperator" Label="Operator" Value="@GetConditionOperator(_selected)" ValueChanged="@(value => SetValue(_selected, "conditionOperator", value.ToString()))" Variant="Variant.Outlined">
                            @foreach (var op in Enum.GetValues<WorkflowConditionOperator>())
                            {
                                <MudSelectItem T="WorkflowConditionOperator" Value="@op">@op</MudSelectItem>
                            }
                        </MudSelect>
                        @if (GetConditionOperator(_selected) is not WorkflowConditionOperator.IsNull and not WorkflowConditionOperator.IsNotNull)
                        {
                            <MudTextField T="string" Label="Compare value" Value="@GetValue(_selected, "conditionValue")" ValueChanged="@(value => SetValue(_selected, "conditionValue", value))" Variant="Variant.Outlined" />
                        }
                        @if (_selected.Kind == WorkflowStepKind.While)
                        {
                            <MudNumericField T="int?" Label="Max iterations" Value="@GetInt(_selected, "maxIterations", 10000)" ValueChanged="@(value => SetValue(_selected, "maxIterations", value?.ToString(CultureInfo.InvariantCulture)))" Variant="Variant.Outlined" />
                        }
                    }
                    else if (_selected.Kind == WorkflowStepKind.For)
                    {
                        <MudSelect T="string" Label="Loop variable" Value="@GetValue(_selected, "variable")" ValueChanged="@(value => SetValue(_selected, "variable", value))" Variant="Variant.Outlined">
                            @foreach (var variable in NumericVariables)
                            {
                                <MudSelectItem T="string" Value="@variable.Name">$@variable.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="long" Label="From" Value="@GetLong(_selected, "from", 0)" ValueChanged="@(value => SetValue(_selected, "from", value.ToString(CultureInfo.InvariantCulture)))" Variant="Variant.Outlined" />
                        <MudNumericField T="long" Label="To" Value="@GetLong(_selected, "to", 3)" ValueChanged="@(value => SetValue(_selected, "to", value.ToString(CultureInfo.InvariantCulture)))" Variant="Variant.Outlined" />
                        <MudNumericField T="long" Label="Step" Value="@GetLong(_selected, "step", 1)" ValueChanged="@(value => SetValue(_selected, "step", value.ToString(CultureInfo.InvariantCulture)))" Variant="Variant.Outlined" />
                        <MudCheckBox T="bool" Label="Inclusive end" Value="@GetBool(_selected, "inclusive")" ValueChanged="@(value => SetValue(_selected, "inclusive", value.ToString()))" />
                    }
                    else if (_selected.Kind == WorkflowStepKind.Foreach)
                    {
                        <MudSelect T="string" Label="Collection variable" Value="@GetValue(_selected, "collection")" ValueChanged="@(value => SetValue(_selected, "collection", value))" Variant="Variant.Outlined">
                            @foreach (var variable in CollectionVariables)
                            {
                                <MudSelectItem T="string" Value="@variable.Name">$@variable.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField T="string" Label="Item variable" Value="@GetValue(_selected, "itemVariable")" ValueChanged="@(value => SetValue(_selected, "itemVariable", value))" Variant="Variant.Outlined" />
                    }
                    else if (_selected.Kind == WorkflowStepKind.Set)
                    {
                        <MudSelect T="string" Label="Variable" Value="@GetValue(_selected, "variable")" ValueChanged="@(value => SetValue(_selected, "variable", value))" Variant="Variant.Outlined">
                            @foreach (var variable in _variables)
                            {
                                <MudSelectItem T="string" Value="@variable.Name">$@variable.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="WorkflowSetOperation" Label="Operation" Value="@GetSetOperation(_selected)" ValueChanged="@(value => SetValue(_selected, "operation", value.ToString()))" Variant="Variant.Outlined">
                            @foreach (var operation in Enum.GetValues<WorkflowSetOperation>())
                            {
                                <MudSelectItem T="WorkflowSetOperation" Value="@operation">@operation</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField T="string" Label="Value" Value="@GetValue(_selected, "value")" ValueChanged="@(value => SetValue(_selected, "value", value))" Variant="Variant.Outlined" />
                    }
                    else if (_selected.Kind == WorkflowStepKind.Exit)
                    {
                        <MudNumericField T="int" Label="Exit code (0 = success)" Value="@GetInt(_selected, "exitCode", 0)" ValueChanged="@(value => SetValue(_selected, "exitCode", value.ToString(CultureInfo.InvariantCulture)))" Variant="Variant.Outlined" />
                    }

                    @if (_selected.IsContainer)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Use the + button on THEN/BODY/ELSE to add a step inside this block.</MudText>
                    }
                </MudStack>
            }
        </aside>
    </div>

    <MudPaper Class="execution-console" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-3 py-2">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" />
            <MudText Typo="Typo.subtitle2">Execution console</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearConsole">Clear</MudButton>
        </MudStack>
        <MudDivider />
        <pre class="execution-output">@_console</pre>
    </MudPaper>
</MudStack>

    <MudDialog @bind-Visible="_showEnvironmentDialog"
               Options="new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true }">
        <DialogContent>
            <MudTabs Rounded="true">
                <MudTabPanel Text="Environments" Icon="@Icons.Material.Filled.Public">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                            <MudSelect T="string"
                                       Label="Environment"
                                       Value="@(_selectedEnvironmentId ?? string.Empty)"
                                       ValueChanged="SelectEnvironmentAsync"
                                       Variant="Variant.Outlined"
                                       Class="environment-select">
                                @foreach (var environment in _environments)
                                {
                                    <MudSelectItem T="string" Value="@environment.Id">@environment.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string"
                                          Label="New environment"
                                          Placeholder="Development"
                                          Value="@_newEnvironmentName"
                                          ValueChanged="value => _newEnvironmentName = value"
                                          Variant="Variant.Outlined" />
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Disabled="@string.IsNullOrWhiteSpace(_newEnvironmentName)"
                                       OnClick="AddEnvironmentAsync">
                                Add
                            </MudButton>
                            @if (_selectedEnvironmentId is not null)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               OnClick="DeleteEnvironmentAsync" />
                            }
                        </MudStack>

                        @if (_selectedEnvironment is not null)
                        {
                            <MudPaper Outlined="true" Class="pa-3 environment-summary">
                                <MudText Typo="Typo.subtitle2">@_selectedEnvironment.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Values below are persisted with this execution environment.
                                </MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudTabPanel>

                <MudTabPanel Text="Variables" Icon="@Icons.Material.Filled.DataObject">
                    <MudStack Spacing="2" Class="pa-2">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Global variables are mutable execution state. Environment values initialize them.
                            References use <code>$name</code> or <code>&#64;name</code>.
                        </MudText>

                        <MudPaper Outlined="true" Class="pa-3">
                            <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField T="string" Label="Name" Value="@_newVariableName" ValueChanged="value => _newVariableName = value" Variant="Variant.Outlined" />
                                <MudSelect T="string" Label="Type" Value="@_newVariableType" ValueChanged="value => _newVariableType = value" Variant="Variant.Outlined">
                                    @foreach (var type in VariableTypes)
                                    {
                                        <MudSelectItem T="string" Value="@type.Value">@type.Key</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField T="string" Label="Default" Value="@_newVariableDefault" ValueChanged="value => _newVariableDefault = value" Variant="Variant.Outlined" />
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Disabled="@string.IsNullOrWhiteSpace(_newVariableName)"
                                           OnClick="AddVariableAsync">
                                    Add variable
                                </MudButton>
                            </MudStack>
                        </MudPaper>

                        @if (_variables.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">No global variables have been created yet.</MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                @foreach (var variable in _variables)
                                {
                                    <MudPaper Class="pa-3 variable-row" Outlined="true">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudIcon Icon="@Icons.Material.Filled.DataObject" />
                                            <MudText Typo="Typo.subtitle2">@variable.Name</MudText>
                                            <MudChip T="string" Size="Size.Small">@variable.Type</MudChip>
                                            <MudSpacer />
                                            @if (!HasActiveDebugSession)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => RemoveVariableAsync(variable.Key))" />
                                            }
                                        </MudStack>

                                        @if (_selectedEnvironment is not null)
                                        {
                                            <MudTextField T="string"
                                                          Label="@($"Environment value — {variable.Name}")"
                                                          Value="@(GetEnvironmentValue(variable.Key) ?? string.Empty)"
                                                          ValueChanged="@((string? value) => SetEnvironmentValueAsync(variable.Key, value))"
                                                          Variant="Variant.Outlined"
                                                          Disabled="@HasActiveDebugSession"
                                                          Class="mt-2" />
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" OnClick="@(() => _showEnvironmentDialog = false)">Done</MudButton>
        </DialogActions>
    </MudDialog>

@code {
    private string _search = string.Empty;
    private string _console = string.Empty;
    private string? _activeStepId;
    private readonly List<AutomationVariableDefinition> _variables = [];
    private List<AutomationEnvironment> _environments = [];
    private string? _selectedEnvironmentId;
    private string _newEnvironmentName = string.Empty;
    private string _newVariableName = string.Empty;
    private string _newVariableType = "System.String";
    private string _newVariableDefault = string.Empty;
    private EditorFlowStep? _selected;
    private WorkflowExecutionSession? _debugSession;
    private Task<WorkflowExecutionResult>? _debugTask;
    private int _nextSequence = 1;
    private bool _showEnvironmentDialog;
    private string? _dragPayload;

    private readonly List<EditorFlowStep> _steps = [];

    private static readonly IReadOnlyDictionary<string, string> VariableTypes = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["String"] = "System.String",
        ["Boolean"] = "System.Boolean",
        ["Int32"] = "System.Int32",
        ["Int64"] = "System.Int64",
        ["Double"] = "System.Double",
        ["Decimal"] = "System.Decimal",
        ["Guid"] = "System.Guid",
        ["DateTime"] = "System.DateTime",
        ["TimeSpan"] = "System.TimeSpan",
        ["String[]"] = "System.String[]"
    };

    private AutomationEnvironment? _selectedEnvironment => _environments.FirstOrDefault(x => x.Id == _selectedEnvironmentId);
    private IEnumerable<AutomationVariableDefinition> NumericVariables => _variables.Where(x => x.Type is "System.Int32" or "System.Int64" or "System.Double" or "System.Decimal");
    private IEnumerable<AutomationVariableDefinition> CollectionVariables => _variables.Where(x => x.Type.EndsWith("[]", StringComparison.Ordinal));
    private IEnumerable<ModuleDescriptor> Modules => ModuleRegistry.List().Where(x =>
        x.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        x.Id.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private bool HasActiveDebugSession => _debugSession is not null && _debugSession.State is not ExecutionControlState.Completed and not ExecutionControlState.Stopped;
    private bool CanPlay => _debugSession is null || _debugSession.State is ExecutionControlState.Paused;
    private bool CanPause => _debugSession?.State is ExecutionControlState.Running or ExecutionControlState.StepInto or ExecutionControlState.StepOver;
    private bool CanStep => HasActiveDebugSession && _debugSession!.State is ExecutionControlState.Paused;
    private bool CanStop => HasActiveDebugSession;

    private string DebugStatus => _debugSession?.State switch
    {
        ExecutionControlState.Running => "Running",
        ExecutionControlState.StepInto or ExecutionControlState.StepOver => "Stepping",
        ExecutionControlState.Paused => "Paused",
        ExecutionControlState.Completed => "Completed",
        ExecutionControlState.Stopped => "Stopped",
        _ => "Ready"
    };

    private Color DebugStatusColor => _debugSession?.State switch
    {
        ExecutionControlState.Running or ExecutionControlState.StepInto or ExecutionControlState.StepOver => Color.Success,
        ExecutionControlState.Paused => Color.Warning,
        ExecutionControlState.Completed => Color.Info,
        ExecutionControlState.Stopped => Color.Error,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync()
    {
        var workflow = BuildWorkflow();
        _environments = [.. await EnvironmentService.SynchronizeAsync(workflow)];
        if (_environments.Count == 0)
            _environments = [await EnvironmentService.CreateAsync("Default", workflow)];
        _selectedEnvironmentId = _environments[0].Id;
    }

    private void BeginDragIf() => BeginDrag("control:if");
    private void BeginDragFor() => BeginDrag("control:for");
    private void BeginDragForeach() => BeginDrag("control:foreach");
    private void BeginDragWhile() => BeginDrag("control:while");
    private void BeginDragSet() => BeginDrag("control:set");
    private void BeginDragExit() => BeginDrag("control:exit");

    private void BeginDrag(string payload)
    {
        if (HasActiveDebugSession)
            return;

        _dragPayload = payload;
    }

    private void BeginDragModule(string moduleId) => BeginDrag($"module:{moduleId}");

    private Task DropRootAsync()
    {
        return InsertDraggedStepAsync(null, false);
    }

    private Task DropChildAsync((EditorFlowStep Parent, bool ElseBranch) target)
    {
        return InsertDraggedStepAsync(target.Parent, target.ElseBranch);
    }

    private async Task AddDraggedStep(string payload)
    {
        BeginDrag(payload);
        await InsertDraggedStepAsync(null, false);
    }

    private Task InsertDraggedStepAsync(EditorFlowStep? parent, bool elseBranch)
    {
        if (HasActiveDebugSession || string.IsNullOrWhiteSpace(_dragPayload))
            return Task.CompletedTask;

        var step = CreateDraggedStep(_dragPayload);
        _dragPayload = null;

        if (step is null)
            return Task.CompletedTask;

        if (parent is null)
            _steps.Add(step);
        else
            (elseBranch ? parent.ElseChildren : parent.Children).Add(step);

        _selected = step;
        return InvokeAsync(StateHasChanged);
    }

    private EditorFlowStep? CreateDraggedStep(string payload)
    {
        if (payload.StartsWith("module:", StringComparison.Ordinal))
        {
            var moduleId = payload["module:".Length..];
            return CreateModuleStep(ModuleRegistry.List().FirstOrDefault(x => x.Id == moduleId)!);
        }

        if (!payload.StartsWith("control:", StringComparison.Ordinal))
            return null;

        var kind = payload["control:".Length..];
        return kind switch
        {
            "if" => CreateIfStep(),
            "for" => CreateForStep(),
            "foreach" => CreateForeachStep(),
            "while" => CreateWhileStep(),
            "set" => CreateSetStep(),
            "exit" => CreateExitStep(),
            _ => null
        };
    }

    private EditorFlowStep CreateIfStep()
    {
        var step = CreateControlStep("If / Else", WorkflowStepKind.If, Icons.Material.Filled.CallSplit, "Conditional branch");
        step.Values["conditionVariable"] = _variables.FirstOrDefault()?.Name ?? string.Empty;
        step.Values["conditionOperator"] = WorkflowConditionOperator.Equals.ToString();
        step.Values["conditionValue"] = string.Empty;
        return step;
    }

    private EditorFlowStep CreateForStep()
    {
        var step = CreateControlStep("For loop", WorkflowStepKind.For, Icons.Material.Filled.Repeat, "Numeric range loop");
        step.Values["variable"] = NumericVariables.FirstOrDefault()?.Name ?? string.Empty;
        step.Values["from"] = "0";
        step.Values["to"] = "3";
        step.Values["step"] = "1";
        step.Values["inclusive"] = "false";
        return step;
    }

    private EditorFlowStep CreateForeachStep()
    {
        var step = CreateControlStep("Foreach loop", WorkflowStepKind.Foreach, Icons.Material.Filled.Loop, "Collection loop");
        step.Values["collection"] = CollectionVariables.FirstOrDefault()?.Name ?? string.Empty;
        step.Values["itemVariable"] = "item";
        return step;
    }

    private EditorFlowStep CreateWhileStep()
    {
        var step = CreateControlStep("While loop", WorkflowStepKind.While, Icons.Material.Filled.Sync, "Condition-controlled loop");
        step.Values["conditionVariable"] = _variables.FirstOrDefault()?.Name ?? string.Empty;
        step.Values["conditionOperator"] = WorkflowConditionOperator.LessThan.ToString();
        step.Values["conditionValue"] = "3";
        step.Values["maxIterations"] = "10000";
        return step;
    }

    private EditorFlowStep CreateSetStep()
    {
        var step = CreateControlStep("Set variable", WorkflowStepKind.Set, Icons.Material.Filled.Edit, "Mutates a workflow variable");
        step.Values["variable"] = _variables.FirstOrDefault()?.Name ?? string.Empty;
        step.Values["operation"] = WorkflowSetOperation.Set.ToString();
        step.Values["value"] = string.Empty;
        return step;
    }

    private EditorFlowStep CreateExitStep()
    {
        var step = CreateControlStep("Exit", WorkflowStepKind.Exit, Icons.Material.Filled.StopCircle, "Terminates the workflow with an explicit exit code");
        step.Values["exitCode"] = "0";
        return step;
    }

    private void AddEcho() => AddModule(ModuleRegistry.List().FirstOrDefault(x => x.Id == "core.echo"));
    
    private void AddModule(ModuleDescriptor? module)
    {
        if (module is null || HasActiveDebugSession)
            return;

        var step = CreateModuleStep(module);
        if (_selected?.IsContainer == true)
            _selected.Children.Add(step);
        else
            _steps.Add(step);
        _selected = step;
        StateHasChanged();
    }

    private EditorFlowStep CreateModuleStep(ModuleDescriptor module)
    {
        var step = new EditorFlowStep(
            Guid.NewGuid().ToString("N"),
            module.DisplayName,
            WorkflowStepKind.Module,
            Icons.Material.Filled.Extension,
            module.Description,
            module.Id,
            module.Parameters.Select(x => new AutomationParameterDescriptor(x.Name, x.Type, x.Required, x.Description)).ToList())
        { Sequence = _nextSequence++ };

        foreach (var parameter in step.Parameters)
            step.Values[parameter.Name] = parameter.Required ? null : null;
        return step;
    }

    private void AddIf() => AddTopLevel(CreateIfStep());
    private void AddFor() => AddTopLevel(CreateForStep());
    private void AddForeach() => AddTopLevel(CreateForeachStep());
    private void AddWhile() => AddTopLevel(CreateWhileStep());
    private void AddSet() => AddTopLevel(CreateSetStep());
    private void AddExit() => AddTopLevel(CreateExitStep());

    private EditorFlowStep CreateControlStep(string title, WorkflowStepKind kind, string icon, string description) =>
        new(Guid.NewGuid().ToString("N"), title, kind, icon, description) { Sequence = _nextSequence++ };

    private void AddTopLevel(EditorFlowStep step)
    {
        if (_selected?.IsContainer == true)
            _selected.Children.Add(step);
        else
            _steps.Add(step);
        _selected = step;
        StateHasChanged();
    }

    private Task AddChildAsync((EditorFlowStep Parent, bool ElseBranch) request)
    {
        if (HasActiveDebugSession)
            return Task.CompletedTask;

        var echo = ModuleRegistry.List().FirstOrDefault(x => x.Id == "core.echo");
        if (echo is null)
            return Task.CompletedTask;

        var child = CreateModuleStep(echo);
        child.Values["message"] = "Step inside block";
        (request.ElseBranch ? request.Parent.ElseChildren : request.Parent.Children).Add(child);
        _selected = child;
        return InvokeAsync(StateHasChanged);
    }

    private void SelectStep(EditorFlowStep step) => _selected = step;

    private async Task RemoveStepAsync(EditorFlowStep step)
    {
        if (HasActiveDebugSession)
            return;

        if (!RemoveFromTree(_steps, step))
            return;

        _variables.RemoveAll(x => x.Scope == AutomationVariableScope.Local && x.StepId == step.Id);
        if (_selected?.Id == step.Id)
            _selected = null;

        await SynchronizeEnvironmentsAsync();
    }

    private static bool RemoveFromTree(IList<EditorFlowStep> nodes, EditorFlowStep target)
    {
        if (nodes.Remove(target))
            return true;

        foreach (var node in nodes)
        {
            if (RemoveFromTree(node.Children, target) || RemoveFromTree(node.ElseChildren, target))
                return true;
        }
        return false;
    }

    private int CountSteps(IEnumerable<EditorFlowStep> steps) =>
        steps.Sum(x => 1 + CountSteps(x.Children) + CountSteps(x.ElseChildren));

    private string? GetParameter(EditorFlowStep step, string name) =>
        step.Values.TryGetValue(name, out var value) ? value : null;

    private void SetParameter(EditorFlowStep step, string name, string? value) =>
        step.Values[name] = value;

    private string GetValue(EditorFlowStep step, string name) =>
        step.Values.TryGetValue(name, out var value) ? value ?? string.Empty : string.Empty;

    private void SetValue(EditorFlowStep step, string name, string? value)
    {
        step.Values[name] = value;
        StateHasChanged();
    }

    private WorkflowConditionOperator GetConditionOperator(EditorFlowStep step) =>
        Enum.TryParse<WorkflowConditionOperator>(GetValue(step, "conditionOperator"), true, out var value) ? value : WorkflowConditionOperator.Equals;

    private WorkflowSetOperation GetSetOperation(EditorFlowStep step) =>
        Enum.TryParse<WorkflowSetOperation>(GetValue(step, "operation"), true, out var value) ? value : WorkflowSetOperation.Set;

    private long GetLong(EditorFlowStep step, string key, long fallback) =>
        long.TryParse(GetValue(step, key), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : fallback;

    private int GetInt(EditorFlowStep step, string key, int fallback) =>
        int.TryParse(GetValue(step, key), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value) ? value : fallback;

    private bool GetBool(EditorFlowStep step, string key) =>
        bool.TryParse(GetValue(step, key), out var value) && value;

    private AutomationWorkflow BuildWorkflow()
    {
        var steps = _steps.Select(BuildWorkflowStep).ToArray();
        return new AutomationWorkflow(WorkflowJson.CurrentSchemaVersion, "Editor automation", steps, [.. _variables]);
    }

    private WorkflowStep BuildWorkflowStep(EditorFlowStep step)
    {
        return step.Kind switch
        {
            WorkflowStepKind.Module => new WorkflowStep(step.Id, step.ModuleId!, WorkflowParameterParser.Parse(step.Values, step.Parameters)),
            WorkflowStepKind.If => new IfStep(
                step.Id,
                BuildCondition(step),
                step.Children.Select(BuildWorkflowStep).ToArray(),
                step.ElseChildren.Count == 0 ? null : step.ElseChildren.Select(BuildWorkflowStep).ToArray()),
            WorkflowStepKind.For => new ForStep(
                step.Id,
                NormalizeVariable(step.Values, "variable"),
                GetLong(step, "from", 0),
                GetLong(step, "to", 3),
                GetLong(step, "step", 1),
                GetBool(step, "inclusive"),
                step.Children.Select(BuildWorkflowStep).ToArray()),
            WorkflowStepKind.Foreach => new ForeachStep(
                step.Id,
                NormalizeVariable(step.Values, "collection"),
                NormalizeVariable(step.Values, "itemVariable"),
                step.Children.Select(BuildWorkflowStep).ToArray()),
            WorkflowStepKind.While => new WhileStep(
                step.Id,
                BuildCondition(step),
                step.Children.Select(BuildWorkflowStep).ToArray(),
                GetInt(step, "maxIterations", 10000)),
            WorkflowStepKind.Set => new SetStep(
                step.Id,
                NormalizeVariable(step.Values, "variable"),
                ParseVariableValue(step.Values.TryGetValue("variable", out var variable) ? variable : null, GetValue(step, "value")),
                Enum.TryParse<WorkflowSetOperation>(GetValue(step, "operation"), true, out var operation) ? operation : WorkflowSetOperation.Set),
            WorkflowStepKind.Exit => new ExitStep(step.Id, GetInt(step, "exitCode", 0)),
            _ => throw new InvalidDataException($"Unsupported editor step kind '{step.Kind}'.")
        };
    }

    private WorkflowCondition BuildCondition(EditorFlowStep step)
    {
        var variableName = NormalizeVariable(step.Values, "conditionVariable");
        var variable = _variables.FirstOrDefault(x => x.Name.Equals(variableName, StringComparison.Ordinal));
        var operation = GetConditionOperator(step);
        var value = operation is WorkflowConditionOperator.IsNull or WorkflowConditionOperator.IsNotNull
            ? null
            : ParseVariableValue(variableName, GetValue(step, "conditionValue"), variable?.Type);
        return new WorkflowCondition(variableName, operation, value);
    }

    private object? ParseVariableValue(string? variableName, string value, string? explicitType = null)
    {
        var name = variableName?.TrimStart('$', '@');
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (value.StartsWith('$') || value.StartsWith('@'))
            return value;

        var type = explicitType
            ?? _variables.FirstOrDefault(x => x.Name.Equals(name, StringComparison.Ordinal))?.Type
            ?? "System.String";

        return WorkflowParameterParser.Parse(value, type);
    }

    private static string NormalizeVariable(IReadOnlyDictionary<string, string?> values, string key) =>
        values.TryGetValue(key, out var value) ? (value ?? string.Empty).TrimStart('$', '@') : string.Empty;

    private async Task SelectEnvironmentAsync(string? id)
    {
        _selectedEnvironmentId = id;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddEnvironmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEnvironmentName))
            return;

        var workflow = BuildWorkflow();
        var environment = await EnvironmentService.CreateAsync(_newEnvironmentName, workflow);
        _environments = [.. await EnvironmentService.ListAsync(workflow)];
        _selectedEnvironmentId = environment.Id;
        _newEnvironmentName = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteEnvironmentAsync()
    {
        if (_selectedEnvironmentId is null)
            return;

        await EnvironmentService.DeleteAsync(_selectedEnvironmentId);
        var workflow = BuildWorkflow();
        _environments = [.. await EnvironmentService.ListAsync(workflow)];

        if (_environments.Count == 0)
            _environments = [await EnvironmentService.CreateAsync("Default", workflow)];

        _selectedEnvironmentId = _environments[0].Id;
        await InvokeAsync(StateHasChanged);
    }

    private string? GetEnvironmentValue(string key) =>
        _selectedEnvironment?.Values.TryGetValue(key, out var value) == true ? value : null;

    private async Task SetEnvironmentValueAsync(string key, string? value)
    {
        if (_selectedEnvironment is null)
            return;

        var values = new Dictionary<string, string?>(_selectedEnvironment.Values, StringComparer.Ordinal)
        {
            [key] = value
        };

        var saved = await EnvironmentService.SaveAsync(
            _selectedEnvironment with { Values = values },
            BuildWorkflow());

        _environments = [.. _environments.Select(x => x.Id == saved.Id ? saved : x)];
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddVariableAsync()
    {
        if (string.IsNullOrWhiteSpace(_newVariableName))
            return;

        var name = _newVariableName.Trim();
        if (_variables.Any(x => x.Name.Equals(name, StringComparison.Ordinal)))
            return;

        var variable = new AutomationVariableDefinition(
            name,
            AutomationVariableScope.Global,
            null,
            null,
            _newVariableType,
            string.IsNullOrWhiteSpace(_newVariableDefault)
                ? null
                : WorkflowParameterParser.Parse(_newVariableDefault, _newVariableType));

        _variables.Add(variable);
        _newVariableName = string.Empty;
        _newVariableDefault = string.Empty;
        await SynchronizeEnvironmentsAsync();
    }

    private async Task RemoveVariableAsync(string key)
    {
        _variables.RemoveAll(x => x.Key.Equals(key, StringComparison.Ordinal));
        await SynchronizeEnvironmentsAsync();
    }

    private async Task SynchronizeEnvironmentsAsync()
    {
        _environments = [.. await EnvironmentService.SynchronizeAsync(BuildWorkflow())];

        if (_selectedEnvironmentId is not null && !_environments.Any(x => x.Id == _selectedEnvironmentId))
            _selectedEnvironmentId = _environments.FirstOrDefault()?.Id;

        await InvokeAsync(StateHasChanged);
    }

    private async Task DebugAsync()
    {
        if (HasActiveDebugSession)
            return;

        try
        {
            var workflow = BuildWorkflow();
            WorkflowJson.Validate(workflow);

            _console = string.Empty;
            _activeStepId = null;

            var sink = new UiEventSink(this);
            _debugSession = new WorkflowExecutionSession(
                WorkflowEngine,
                workflow,
                sink,
                _selectedEnvironment);

            _debugTask = _debugSession.RunAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            AppendConsole($"[ERROR] {ex.Message}\n");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnsureDebugSessionAsync()
    {
        if (!HasActiveDebugSession)
            await DebugAsync();
    }

    private async Task Play()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.Play();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepInto()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.StepInto();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepOver()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.StepOver();
        await InvokeAsync(StateHasChanged);
    }

    private void Pause()
    {
        _debugSession?.Pause();
        StateHasChanged();
    }

    private async Task StopAsync()
    {
        _debugSession?.Stop();

        if (_debugTask is not null)
        {
            try
            {
                await _debugTask;
            }
            catch
            {
            }
        }

        _debugSession = null;
        _debugTask = null;
        _activeStepId = null;
        await InvokeAsync(StateHasChanged);
    }

    private void ClearConsole()
    {
        _console = string.Empty;
        StateHasChanged();
    }

    private void AppendConsole(string text) => _console += text;

    private async Task SynchronizeAndRenderAsync()
    {
        await SynchronizeEnvironmentsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private int GetStepNumber(string? stepId)
    {
        if (string.IsNullOrWhiteSpace(stepId))
            return 0;

        var step = FindStep(_steps, stepId);
        return step?.Sequence ?? 0;
    }

    private static EditorFlowStep? FindStep(IEnumerable<EditorFlowStep> nodes, string id)
    {
        foreach (var node in nodes)
        {
            if (node.Id == id)
                return node;

            var child = FindStep(node.Children, id) ?? FindStep(node.ElseChildren, id);
            if (child is not null)
                return child;
        }

        return null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_debugSession is not null)
            await _debugSession.DisposeAsync();
    }

    private sealed class UiEventSink(Editor page) : IExecutionEventSink
    {
        public async ValueTask OnEventAsync(
            ExecutionEvent item,
            CancellationToken cancellationToken = default)
        {
            await page.InvokeAsync(() =>
            {
                if (!string.IsNullOrWhiteSpace(item.StepId))
                    page._activeStepId = item.StepId;

                var number = page.GetStepNumber(item.StepId);
                var prefix = number > 0 ? $"[STEP.{number:00}]" : "[WORKFLOW]";

                page._console += item.Kind switch
                {
                    "workflow" => $"[WORKFLOW] {item.Message}\n",
                    "running" => $"{prefix} Running: {item.ModuleId}\n",
                    "output" => $"{prefix} {item.Message}\n",
                    "success" => $"{prefix} Succeeded: true\n",
                    "failure" => $"{prefix} Succeeded: false — {item.Message}\n",
                    "condition-evaluated" => $"{prefix} Condition: {item.Message}\n",
                    "branch-selected" => $"{prefix} Branch: {item.Message}\n",
                    "loop-started" => $"{prefix} Loop: {item.Message}\n",
                    "loop-iteration-started" => $"{prefix} Iteration: {item.Message}\n",
                    "variable-changed" => $"{prefix} Variable: {item.Message}\n",
                    "exit" => $"{prefix} Exit code: {item.Message}\n",
                    "completed" => $"[COMPLETED] {item.Message}\n",
                    "cancelled" => $"[CANCELLED] {item.Message}\n",
                    "exception" => $"[EXCEPTION] {item.Message}\n",
                    _ => $"{item.Message}\n"
                };

                page.StateHasChanged();
            });
        }
    }
}
