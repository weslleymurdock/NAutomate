@page "/"
@rendermode InteractiveServer
@using NAutomate.Abstractions
@using NAutomate.Core
@inject FileWorkflowStore Store
@inject WorkflowEngine Engine

<PageTitle>NAutomate Workflow</PageTitle>
<MudText Typo="Typo.h4" GutterBottom="true">Create workflow</MudText>
<MudPaper Class="pa-4">
    <MudTextField @bind-Value="_name" Label="Project name" Required="true" />
    <MudTextField @bind-Value="_message" Label="Echo message" Required="true" Class="mt-4" />
    <MudStack Row="true" Class="mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Save JSON</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="RunAsync" Disabled="_busy">Run</MudButton>
    </MudStack>
</MudPaper>
<MudText Typo="Typo.h5" Class="mt-6">Execution console</MudText>
<MudPaper Class="pa-4 mt-2" Style="min-height:180px; white-space:pre-wrap"><MudText Typo="Typo.body2">@_console</MudText></MudPaper>

@code {
    private string _name = "Hello World";
    private string _message = "Hello from NAutomate";
    private string _console = string.Empty;
    private bool _busy;
    private readonly string _workflowPath = Path.Combine(AppContext.BaseDirectory, "automation.json");

    private AutomationWorkflow CreateWorkflow() => new(WorkflowJson.CurrentSchemaVersion, _name, [new WorkflowStep("step-001", "core.echo", new Dictionary<string, object?> { ["message"] = _message })]);

    private async Task SaveAsync()
    {
        await Store.SaveAsync(_workflowPath, CreateWorkflow());
        _console = $"Saved {_workflowPath}";
    }

    private async Task RunAsync()
    {
        _busy = true;
        _console = string.Empty;
        try
        {
            await Store.SaveAsync(_workflowPath, CreateWorkflow());
            await Engine.ExecuteAsync(CreateWorkflow(), new UiEventSink(this));
        }
        catch (Exception exception) { _console += $"Error: {exception.Message}\n"; }
        finally { _busy = false; }
    }

    private sealed class UiEventSink(Home page) : IExecutionEventSink
    {
        public ValueTask OnEventAsync(ExecutionEvent item, CancellationToken cancellationToken = default)
        {
            page._console += item.Kind switch { "running" => $"[RUNNING] {item.ModuleId}\n", "output" => $"[OUTPUT] {item.Message}\n", "success" => $"[SUCCESS] {item.ModuleId}\n", _ => $"{item.Message}\n" };
            return ValueTask.CompletedTask;
        }
    }
}
