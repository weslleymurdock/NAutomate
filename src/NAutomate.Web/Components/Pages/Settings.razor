@page "/settings"
@rendermode InteractiveServer
@using NAutomate.Abstractions
@inject IEnumerable<IModuleSettingsTabProvider> ModuleSettingsProviders

<PageTitle>Configuration</PageTitle>
<MudStack Spacing="3">
    <MudStack Row="true" AlignItems="AlignItems.Center"><MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/editor" /><div><MudText Typo="Typo.h4">Configuration</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">Host configuration plus tabs supplied by installed module packages.</MudText></div></MudStack>
    <MudPaper Class="pa-2">
        <MudTabs Rounded="true" Elevation="1">
            <MudTabPanel Text="Docker" Icon="@Icons.Material.Filled.ViewInAr">
                <MudStack Class="pa-5" Spacing="3"><MudText Typo="Typo.h6">Docker paths</MudText><MudTextField Label="Docker executable" Value="docker" Variant="Variant.Outlined" /><MudTextField Label="Compose file" Placeholder="docker-compose.yml" Variant="Variant.Outlined" /><MudTextField Label="Docker data directory" Placeholder="C:\docker" Variant="Variant.Outlined" /></MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Dependencies" Icon="@Icons.Material.Filled.Extension">
                <MudStack Class="pa-5" Spacing="3"><MudText Typo="Typo.h6">General dependencies</MudText><MudSwitch T="bool" Label="Validate dependencies before running" Value="true" Color="Color.Primary" /><MudSwitch T="bool" Label="Automatically start local services" Value="false" Color="Color.Primary" /><MudTextField Label="Default working directory" Placeholder="C:\NAutomate\work" Variant="Variant.Outlined" /></MudStack>
            </MudTabPanel>
            <MudTabPanel Text="NuGet Modules" Icon="@Icons.Material.Filled.Inventory2">
                <MudStack Class="pa-5" Spacing="3"><MudText Typo="Typo.h6">Module packages</MudText><MudTextField Label="Modules directory" Placeholder="C:\NAutomate\modules" Variant="Variant.Outlined" /><MudAlert Severity="Severity.Info">Installed NuGet modules can contribute configuration tabs through IModuleSettingsTabProvider.</MudAlert></MudStack>
            </MudTabPanel>
            @foreach (var provider in ModuleSettingsProviders)
            {
                @foreach (var tab in provider.GetTabs())
                {
                    <MudTabPanel Text="@tab.DisplayName" Icon="@Icons.Material.Filled.SettingsApplications">
                        <MudStack Class="pa-5" Spacing="3"><MudText Typo="Typo.h6">@tab.DisplayName</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@tab.Description</MudText>
                            @foreach (var setting in tab.Settings)
                            {
                                <MudTextField Label="@setting.DisplayName" HelperText="@setting.Description" Value="@GetValue(tab, setting)" ValueChanged="@((string? value) => SetValue(tab, setting, value))" Variant="Variant.Outlined" />
                            }
                        </MudStack>
                    </MudTabPanel>
                }
            }
        </MudTabs>
    </MudPaper>
</MudStack>

@code {
    private readonly Dictionary<string, string?> _values = new(StringComparer.OrdinalIgnoreCase);
    private string? GetValue(ModuleSettingsTabDescriptor tab, ModuleSettingDescriptor setting) => _values.TryGetValue($"{tab.ModuleId}:{tab.Id}:{setting.Key}", out var value) ? value : setting.DefaultValue;
    private void SetValue(ModuleSettingsTabDescriptor tab, ModuleSettingDescriptor setting, string? value) => _values[$"{tab.ModuleId}:{tab.Id}:{setting.Key}"] = value;
}
