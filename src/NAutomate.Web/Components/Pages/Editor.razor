@page "/editor"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IExecutionEnvironmentStore EnvironmentStore

<PageTitle>Automation Editor</PageTitle>
<MudStack Spacing="2" Class="editor-shell">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" />
            <div>
                <MudText Typo="Typo.h5">Automation editor / debugger</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_steps.Count steps · Entry point cannot be removed</MudText>
            </div>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudTooltip Text="Initialize the debugger and pause before the first step">
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.BugReport"
                           Disabled="@HasActiveDebugSession"
                           OnClick="DebugAsync">
                    Debug
                </MudButton>
            </MudTooltip>

            <MudDivider Vertical="true" Class="mx-1" />

            <MudTooltip Text="Run continuously">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                               Color="Color.Success"
                               Disabled="@(!CanPlay)"
                               OnClick="Play" />
            </MudTooltip>
            <MudTooltip Text="Pause before the next step">
                <MudIconButton Icon="@Icons.Material.Filled.Pause"
                               Color="Color.Warning"
                               Disabled="@(!CanPause)"
                               OnClick="Pause" />
            </MudTooltip>
            <MudTooltip Text="Stop execution">
                <MudIconButton Icon="@Icons.Material.Filled.Stop"
                               Color="Color.Error"
                               Disabled="@(!CanStop)"
                               OnClick="StopAsync" />
            </MudTooltip>
            <MudTooltip Text="Execute the next step and pause">
                <MudIconButton Icon="@Icons.Material.Filled.SkipNext"
                               Disabled="@(!CanStep)"
                               OnClick="StepInto" />
            </MudTooltip>
            <MudTooltip Text="Step over the next operation">
                <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                               Disabled="@(!CanStep)"
                               OnClick="StepOver" />
            </MudTooltip>

            <MudChip T="string" Size="Size.Small" Color="@DebugStatusColor">@DebugStatus</MudChip>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save">Save</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Href="/settings" />
        </MudStack>
    </MudStack>

    <MudPaper Class="pa-2" Elevation="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Debugger controls execute the workflow from the immutable entry point. Play runs continuously; Step Into and Step Over execute one operation and pause.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-3" Elevation="1">
        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Public" />
                <MudText Typo="Typo.subtitle1">Execution environment</MudText>
                <MudSelect T="string" Label="Environment" Value="@(_selectedEnvironmentId ?? string.Empty)" ValueChanged="SelectEnvironmentAsync" Variant="Variant.Outlined" Class="environment-select">
                    @foreach (var environment in _environments)
                    {
                        <MudSelectItem T="string" Value="@environment.Id">@environment.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Label="New environment" Placeholder="Development" Value="@_newEnvironmentName" ValueChanged="value => _newEnvironmentName = value" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="@string.IsNullOrWhiteSpace(_newEnvironmentName)" OnClick="AddEnvironmentAsync">Add</MudButton>
                @if (_selectedEnvironmentId is not null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="DeleteEnvironmentAsync" />
                }
            </MudStack>

            <MudDivider />

            <MudExpansionPanel Text="Automation variables" Icon="@Icons.Material.Filled.DataObject">
                <MudStack Spacing="2" Class="pa-2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Global variables are available to every operation. Local variables are scoped to a workflow step. Use <code>${name}</code> or <code>${stepId:name}</code> in operation parameters.
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudTextField T="string" Label="Variable name" Value="@_newVariableName" ValueChanged="value => _newVariableName = value" Variant="Variant.Outlined" />
                        <MudSelect T="AutomationVariableScope" Label="Scope" Value="@_newVariableScope" ValueChanged="value => _newVariableScope = value" Variant="Variant.Outlined">
                            <MudSelectItem Value="@AutomationVariableScope.Global">Global</MudSelectItem>
                            <MudSelectItem Value="@AutomationVariableScope.Local">Local</MudSelectItem>
                        </MudSelect>
                        @if (_newVariableScope == AutomationVariableScope.Local)
                        {
                            <MudSelect T="string" Label="Step" Value="@(_newVariableStepId ?? string.Empty)" ValueChanged="value => _newVariableStepId = value" Variant="Variant.Outlined">
                                @foreach (var step in _steps.Where(x => !x.IsEntry))
                                {
                                    <MudSelectItem T="string" Value="@step.Id">@step.Title</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Disabled="@(!CanAddVariable)" OnClick="AddVariableAsync">Add</MudButton>
                    </MudStack>

                    @foreach (var variable in _variables)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudChip T="string" Size="Size.Small" Color="@(variable.Scope == AutomationVariableScope.Global ? Color.Info : Color.Secondary)">@variable.Key</MudChip>
                            @if (!HasActiveDebugSession)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveVariableAsync(variable.Key))" />
                            }
                        </MudStack>
                    }

                    @if (_selectedEnvironment is not null && _variables.Count > 0)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">Values — @_selectedEnvironment.Name</MudText>
                        @foreach (var variable in _variables)
                        {
                            <MudTextField T="string"
                                          Label="@variable.Key"
                                          Value="@(GetEnvironmentValue(variable.Key) ?? string.Empty)"
                                          ValueChanged="@((string? value) => SetEnvironmentValueAsync(variable.Key, value))"
                                          Variant="Variant.Outlined"
                                          Disabled="@HasActiveDebugSession" />
                        }
                    }
                </MudStack>
            </MudExpansionPanel>
        </MudStack>
    </MudPaper>

    <div class="automation-editor">
        <aside class="module-sidebar">
            <MudText Typo="Typo.subtitle1" Class="pa-3">Services & methods</MudText>
            <MudTextField @bind-Value="_search" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="px-3 pb-3" />
            <MudExpansionPanels MultiExpansion="true" Dense="true" Gutters="false">
                @foreach (var family in ModuleGroups)
                {
                    <MudExpansionPanel Text="@family.Key" Icon="@ModuleIcon(family.Key)">
                        <MudExpansionPanels MultiExpansion="true" Dense="true" Gutters="false">
                            @foreach (var serviceGroup in family.GroupBy(GetServiceGroupId))
                            {
                                var service = serviceGroup.SelectMany(module => module.Services ?? []).FirstOrDefault();
                                if (service is null)
                                    continue;

                                <MudExpansionPanel Text="@service.DisplayName" Icon="@Icons.Material.Filled.Terminal">
                                    @foreach (var module in serviceGroup)
                                    {
                                        @foreach (var operation in (module.Services ?? []).SelectMany(x => x.Operations).Where(OperationMatches))
                                        {
                                            <MudButton FullWidth="true" Variant="Variant.Text" Class="method-item" StartIcon="@MethodIcon(operation.ReturnType)" OnClick="@(() => AddStep(module, service, operation))">
                                                <span><span class="method-label">@operation.DisplayName</span><span class="method-id">@operation.Id</span></span>
                                            </MudButton>
                                        }
                                    }
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </aside>

        <main class="flow-canvas">
            <div class="canvas-toolbar">
                <MudChip T="string" Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary">Flow graph</MudChip>
                <MudSpacer />
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AutoFixHigh" OnClick="ResetLayout">Auto layout</MudButton>
            </div>
            <div class="diagram-viewport">
                <div class="diagram-grid"></div>
                <svg class="diagram-links" aria-hidden="true">
                    @for (var i = 0; i < _steps.Count - 1; i++)
                    {
                        <line class="flow-link" data-from="@_steps[i].Id" data-to="@_steps[i + 1].Id" />
                    }
                    <defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor" /></marker></defs>
                </svg>
                @foreach (var step in _steps)
                {
                    <div id="node-@step.Id"
                         class="flow-node @(step.IsEntry ? "entry-node" : "") @(step.Id == _activeStepId ? "active-node" : "")"
                         style="left:@(step.X)px;top:@(step.Y)px"
                         @onclick="@(() => SelectStep(step))">
                        <div class="node-toolbar">
                            <MudIcon Icon="@step.Icon" Size="Size.Small" />
                            <MudText Typo="Typo.caption">@step.Kind</MudText>
                            @if (!step.IsEntry)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Disabled="@HasActiveDebugSession" OnClick="@(() => RemoveStep(step.Id))" />
                            }
                        </div>
                        <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                        <MudText Typo="Typo.caption" Class="node-module">@step.Module</MudText>
                        @if (!step.IsEntry)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => SelectStep(step))">Parameters</MudButton>
                        }
                    </div>
                }
            </div>
        </main>

        <aside class="step-inspector">
            @if (_selected is null)
            {
                <MudStack Class="pa-4" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Step inspector</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Select a step to fill method arguments.</MudText>
                </MudStack>
            }
            else
            {
                <MudStack Class="pa-4" Spacing="2">
                    <MudText Typo="Typo.h6">@_selected.Title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_selected.Description</MudText>
                    <MudDivider />
                    @foreach (var parameter in _selected.Parameters)
                    {
                        <MudTextField Value="@GetParameter(_selected, parameter.Name)"
                                      ValueChanged="@((string? value) => SetParameter(_selected, parameter.Name, value))"
                                      Label="@parameter.Name"
                                      HelperText="@parameter.Description"
                                      Variant="Variant.Outlined"
                                      Disabled="@HasActiveDebugSession" />
                    }
                </MudStack>
            }
        </aside>
    </div>

    <MudPaper Class="execution-console" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="px-3 py-2">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" />
            <MudText Typo="Typo.subtitle2">Execution console</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearConsole">Clear</MudButton>
        </MudStack>
        <MudDivider />
        <pre class="execution-output">@_console</pre>
    </MudPaper>
</MudStack>

@code {
    private string _search = string.Empty;
    private string _console = string.Empty;
    private string? _activeStepId;
    private readonly List<AutomationVariableDefinition> _variables = [];
    private List<AutomationEnvironment> _environments = [];
    private string? _selectedEnvironmentId;
    private string _newEnvironmentName = string.Empty;
    private string _newVariableName = string.Empty;
    private AutomationVariableScope _newVariableScope = AutomationVariableScope.Global;
    private string? _newVariableStepId;
    private FlowStep? _selected;

    private AutomationEnvironment? _selectedEnvironment => _environments.FirstOrDefault(x => x.Id == _selectedEnvironmentId);
    private bool CanAddVariable => !string.IsNullOrWhiteSpace(_newVariableName) && (_newVariableScope == AutomationVariableScope.Global || !string.IsNullOrWhiteSpace(_newVariableStepId));
    private WorkflowExecutionSession? _debugSession;
    private Task<WorkflowExecutionResult>? _debugTask;

    private readonly List<FlowStep> _steps =
    [
        new("entry", "Entrypoint", "workflow.entry", Icons.Material.Filled.PlayArrow, "Entry point", true, 80, 50, "Immutable workflow entry point.", [])
    ];

    private IEnumerable<ModuleDescriptor> Modules =>
        ModuleRegistry.List().Where(x =>
            x.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            x.Id.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<IGrouping<string, ModuleDescriptor>> ModuleGroups =>
        Modules.GroupBy(GetModuleFamily);

    private static string GetModuleFamily(ModuleDescriptor module) =>
        GetModuleFamily(module.Id);

    private static string GetModuleFamily(string moduleId)
    {
        var parts = moduleId.Split('.', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? parts[0]
            : moduleId;
    }

    private static string GetServiceGroupId(ModuleDescriptor module) =>
        module.Services?.FirstOrDefault()?.Id ?? module.Id;

    private bool HasActiveDebugSession =>
        _debugSession is not null &&
        _debugSession.State is not ExecutionControlState.Completed and not ExecutionControlState.Stopped;

    private bool CanPlay =>
        _debugSession is null ||
        _debugSession.State is ExecutionControlState.Paused;

    private bool CanPause =>
        _debugSession?.State is ExecutionControlState.Running or ExecutionControlState.StepInto or ExecutionControlState.StepOver;

    private bool CanStep =>
        HasActiveDebugSession &&
        _debugSession!.State is ExecutionControlState.Paused;

    private bool CanStop =>
        HasActiveDebugSession;

    private string DebugStatus =>
        _debugSession?.State switch
        {
            ExecutionControlState.Running => "Running",
            ExecutionControlState.StepInto => "Stepping",
            ExecutionControlState.StepOver => "Stepping",
            ExecutionControlState.Paused => "Paused",
            ExecutionControlState.Completed => "Completed",
            ExecutionControlState.Stopped => "Stopped",
            _ => "Ready"
        };

    private Color DebugStatusColor =>
        _debugSession?.State switch
        {
            ExecutionControlState.Running or ExecutionControlState.StepInto or ExecutionControlState.StepOver => Color.Success,
            ExecutionControlState.Paused => Color.Warning,
            ExecutionControlState.Completed => Color.Info,
            ExecutionControlState.Stopped => Color.Error,
            _ => Color.Default
        };

    protected override async Task OnInitializedAsync()
    {
        var workflow = BuildWorkflow();
        _environments = [.. await EnvironmentStore.SynchronizeAsync(workflow)];

        if (_environments.Count == 0)
        {
            var environment = await EnvironmentStore.CreateAsync("Default", workflow);
            _environments = [environment];
        }

        _selectedEnvironmentId = _environments[0].Id;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("nautomateFlow.enableDragging");
        await JS.InvokeVoidAsync("nautomateFlow.updateLinks");
    }

    private bool OperationMatches(AutomationOperationDescriptor operation) =>
        string.IsNullOrWhiteSpace(_search) ||
        operation.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
        operation.Id.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private static string ModuleIcon(string id) =>
        id.StartsWith("appium", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Filled.Smartphone
            : id.StartsWith("shell", StringComparison.OrdinalIgnoreCase)
                ? Icons.Material.Filled.Terminal
                : Icons.Material.Filled.Extension;

    private static string MethodIcon(string returnType) =>
        returnType.Equals("System.Void", StringComparison.OrdinalIgnoreCase)
            ? Icons.Material.Filled.PlayCircle
            : Icons.Material.Filled.Output;

    private void AddStep(ModuleDescriptor module, AutomationServiceDescriptor service, AutomationOperationDescriptor operation)
    {
        if (HasActiveDebugSession)
            return;

        var step = new FlowStep(
            Guid.NewGuid().ToString("N"),
            operation.DisplayName,
            $"{module.Id} · {service.DisplayName}",
            MethodIcon(operation.ReturnType),
            operation.Id,
            false,
            80,
            190 + (_steps.Count - 1) * 145,
            operation.Description,
            operation.Parameters.ToList());

        _steps.Add(step);
        _selected = step;
    }

    private void RemoveStep(string id)
    {
        if (id == "entry" || HasActiveDebugSession)
            return;

        _steps.RemoveAll(x => x.Id == id);

        if (_selected?.Id == id)
            _selected = null;
    }

    private void SelectStep(FlowStep step) => _selected = step;

    private string? GetParameter(FlowStep step, string name) =>
        step.Values.TryGetValue(name, out var value) ? value : null;

    private void SetParameter(FlowStep step, string name, string? value) =>
        step.Values[name] = value;

    private AutomationWorkflow BuildWorkflow()
    {
        var steps = _steps
            .Where(step => !step.IsEntry)
            .Select(step => new WorkflowStep(
                step.Id,
                step.ModuleId,
                step.Values.ToDictionary(x => x.Key, x => (object?)x.Value, StringComparer.Ordinal))).ToArray();

        return new AutomationWorkflow(
            WorkflowJson.CurrentSchemaVersion,
            "Editor automation",
            steps,
            [.. _variables]);
    }


    private async Task SelectEnvironmentAsync(string? id)
    {
        _selectedEnvironmentId = id;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddEnvironmentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEnvironmentName))
            return;

        var workflow = BuildWorkflow();
        var environment = await EnvironmentStore.CreateAsync(_newEnvironmentName, workflow);
        _environments = [.. await EnvironmentStore.ListAsync(workflow.Name)];
        _selectedEnvironmentId = environment.Id;
        _newEnvironmentName = string.Empty;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteEnvironmentAsync()
    {
        if (_selectedEnvironmentId is null)
            return;

        await EnvironmentStore.DeleteAsync(_selectedEnvironmentId);
        var workflow = BuildWorkflow();
        _environments = [.. await EnvironmentStore.ListAsync(workflow.Name)];

        if (_environments.Count == 0)
        {
            var environment = await EnvironmentStore.CreateAsync("Default", workflow);
            _environments = [environment];
        }

        _selectedEnvironmentId = _environments[0].Id;
        await InvokeAsync(StateHasChanged);
    }

    private string? GetEnvironmentValue(string key) =>
        _selectedEnvironment?.Values.TryGetValue(key, out var value) == true ? value : null;

    private async Task SetEnvironmentValueAsync(string key, string? value)
    {
        if (_selectedEnvironment is null)
            return;

        var values = new Dictionary<string, string?>(_selectedEnvironment.Values, StringComparer.Ordinal)
        {
            [key] = value
        };

        var saved = await EnvironmentStore.SaveAsync(
            _selectedEnvironment with { Values = values },
            BuildWorkflow());

        _environments = [.. _environments.Select(x => x.Id == saved.Id ? saved : x)];
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddVariableAsync()
    {
        if (!CanAddVariable)
            return;

        var variable = new AutomationVariableDefinition(
            _newVariableName.Trim(),
            _newVariableScope,
            _newVariableScope == AutomationVariableScope.Local ? _newVariableStepId : null);

        if (_variables.Any(x => x.Key.Equals(variable.Key, StringComparison.Ordinal)))
            return;

        _variables.Add(variable);
        _newVariableName = string.Empty;
        _newVariableStepId = null;
        await SynchronizeEnvironmentsAsync();
    }

    private async Task RemoveVariableAsync(string key)
    {
        _variables.RemoveAll(x => x.Key.Equals(key, StringComparison.Ordinal));
        await SynchronizeEnvironmentsAsync();
    }

    private async Task SynchronizeEnvironmentsAsync()
    {
        _environments = [.. await EnvironmentStore.SynchronizeAsync(BuildWorkflow())];

        if (_selectedEnvironmentId is not null && !_environments.Any(x => x.Id == _selectedEnvironmentId))
            _selectedEnvironmentId = _environments.FirstOrDefault()?.Id;

        await InvokeAsync(StateHasChanged);
    }

    private async Task DebugAsync()
    {
        if (HasActiveDebugSession)
            return;

        if (_steps.Count == 1)
        {
            AppendConsole("[DEBUG] Add at least one operation after the entry point.\n");
            return;
        }

        await StopExistingSessionAsync();

        try
        {
            var workflow = BuildWorkflow();
            WorkflowJson.Validate(workflow);

            _console = string.Empty;
            _activeStepId = null;

            var sink = new UiEventSink(this);
            _debugSession = new WorkflowExecutionSession(WorkflowEngine, workflow, sink, _selectedEnvironment);
            _debugTask = _debugSession.RunAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            AppendConsole($"[ERROR] {ex.Message}\n");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task EnsureDebugSessionAsync()
    {
        if (!HasActiveDebugSession)
            await DebugAsync();
    }

    private async Task Play()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.Play();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepInto()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.StepInto();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StepOver()
    {
        await EnsureDebugSessionAsync();
        _debugSession?.StepOver();
        await InvokeAsync(StateHasChanged);
    }

    private void Pause()
    {
        _debugSession?.Pause();
        StateHasChanged();
    }

    private async Task StopAsync()
    {
        _debugSession?.Stop();

        if (_debugTask is not null)
        {
            try
            {
                await _debugTask;
            }
            catch
            {
                // The session converts execution failures into WorkflowExecutionResult.
            }
        }

        _debugSession = null;
        _debugTask = null;
        _activeStepId = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StopExistingSessionAsync()
    {
        if (_debugSession is null)
            return;

        await StopAsync();
    }

    private void ClearConsole()
    {
        _console = string.Empty;
        StateHasChanged();
    }

    private void AppendConsole(string text)
    {
        _console += text;
    }

    private async Task ResetLayout()
    {
        if (HasActiveDebugSession)
            return;

        for (var i = 0; i < _steps.Count; i++)
        {
            _steps[i].X = 80;
            _steps[i].Y = 50 + i * 145;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_debugSession is not null)
            await _debugSession.DisposeAsync();
    }

    private sealed class UiEventSink(Editor page) : IExecutionEventSink
    {
        public async ValueTask OnEventAsync(ExecutionEvent item, CancellationToken cancellationToken = default)
        {
            await page.InvokeAsync(() =>
            {
                if (!string.IsNullOrWhiteSpace(item.StepId))
                    page._activeStepId = item.StepId;

                page._console += item.Kind switch
                {
                    "workflow" => $"[WORKFLOW] {item.Message}\n",
                    "running" => $"[RUNNING] {item.StepId}: {item.ModuleId}\n",
                    "output" => $"[OUTPUT] {item.Message}\n",
                    "success" => $"[SUCCESS] {item.StepId}\n",
                    "failure" => $"[FAILURE] {item.StepId}: {item.Message}\n",
                    "completed" => $"[COMPLETED] {item.Message}\n",
                    "cancelled" => $"[CANCELLED] {item.Message}\n",
                    "exception" => $"[EXCEPTION] {item.Message}\n",
                    _ => $"{item.Message}\n"
                };

                page.StateHasChanged();
            });
        }
    }

    private sealed class FlowStep
    {
        public FlowStep(
            string id,
            string title,
            string module,
            string icon,
            string kind,
            bool isEntry,
            double x,
            double y,
            string description,
            List<AutomationParameterDescriptor> parameters)
        {
            Id = id;
            Title = title;
            Module = module;
            ModuleId = module.Split(" · ", StringSplitOptions.None)[0];
            OperationId = kind;
            Icon = icon;
            Kind = kind;
            IsEntry = isEntry;
            X = x;
            Y = y;
            Description = description;
            Parameters = parameters;
        }

        public string Id { get; }
        public string Title { get; }
        public string Module { get; }
        public string ModuleId { get; }
        public string OperationId { get; }
        public string Icon { get; }
        public string Kind { get; }
        public bool IsEntry { get; }
        public double X { get; set; }
        public double Y { get; set; }
        public string Description { get; }
        public List<AutomationParameterDescriptor> Parameters { get; }
        public Dictionary<string, string?> Values { get; } = new(StringComparer.Ordinal);
    }
}
