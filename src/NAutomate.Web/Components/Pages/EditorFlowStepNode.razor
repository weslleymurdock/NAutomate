@using NAutomate.Abstractions

<div class="workflow-block @GetBlockClass() @(Step.Id == ActiveStepId ? "workflow-block-active" : "")" @onclick="SelectAsync">
    <div class="workflow-block-header">
        <div class="workflow-block-title">
            <MudIcon Icon="@Step.Icon" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">@Step.Title</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Step.BranchLabel</MudChip>
        </div>
        <div>
            <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small" OnClick="SelectAsync" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Disabled="@Disabled" OnClick="RemoveAsync" />
        </div>
    </div>

    <MudText Typo="Typo.caption" Class="workflow-block-summary">@Summary</MudText>

    @if (Step.IsContainer)
    {
        <div class="workflow-branch workflow-branch-main">
            <div class="workflow-branch-header">
                <MudText Typo="Typo.caption">@MainBranchLabel</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@Disabled" OnClick="@(() => AddChildAsync(false))" />
            </div>
            @if (Step.Children.Count == 0)
            {
                <div class="workflow-dropzone">Drop or add steps here</div>
            }
            else
            {
                @foreach (var child in Step.Children)
                {
                    <EditorFlowStepNode Step="child" ActiveStepId="@ActiveStepId" Disabled="@Disabled" OnSelected="OnSelected" OnRemoved="OnRemoved" OnAddChild="OnAddChild" />
                }
            }
        </div>

        @if (Step.HasElse)
        {
            <div class="workflow-branch workflow-branch-else">
                <div class="workflow-branch-header">
                    <MudText Typo="Typo.caption">ELSE</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Disabled="@Disabled" OnClick="@(() => AddChildAsync(true))" />
                </div>
                @if (Step.ElseChildren.Count == 0)
                {
                    <div class="workflow-dropzone">Optional else path</div>
                }
                else
                {
                    @foreach (var child in Step.ElseChildren)
                    {
                        <EditorFlowStepNode Step="child" ActiveStepId="@ActiveStepId" Disabled="@Disabled" OnSelected="OnSelected" OnRemoved="OnRemoved" OnAddChild="OnAddChild" />
                    }
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public EditorFlowStep Step { get; set; } = null!;
    [Parameter] public string? ActiveStepId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<EditorFlowStep> OnSelected { get; set; }
    [Parameter] public EventCallback<EditorFlowStep> OnRemoved { get; set; }
    [Parameter] public EventCallback<(EditorFlowStep Parent, bool ElseBranch)> OnAddChild { get; set; }

    private string MainBranchLabel => Step.Kind == WorkflowStepKind.If ? "THEN" : "BODY";

    private string Summary => Step.Kind switch
    {
        WorkflowStepKind.If => $"{GetValue("conditionVariable", "variable")} {GetValue("conditionOperator", "Equals")} {GetValue("conditionValue", "")}".Trim(),
        WorkflowStepKind.For => $"{GetValue("variable", "counter")}: {GetValue("from", "0")} → {GetValue("to", "10")} (step {GetValue("step", "1")})",
        WorkflowStepKind.Foreach => $"{GetValue("itemVariable", "item")} in {GetValue("collection", "items")}",
        WorkflowStepKind.While => $"{GetValue("conditionVariable", "variable")} {GetValue("conditionOperator", "Equals")} {GetValue("conditionValue", "")}",
        WorkflowStepKind.Set => $"{GetValue("variable", "variable")} = {GetValue("value", "")}",
        WorkflowStepKind.Exit => $"Exit code: {GetValue("exitCode", "0")}",
        _ => Step.ModuleId ?? Step.Description
    };

    private string GetBlockClass() => Step.Kind switch
    {
        WorkflowStepKind.If => "workflow-if",
        WorkflowStepKind.For or WorkflowStepKind.Foreach or WorkflowStepKind.While => "workflow-loop",
        WorkflowStepKind.Exit => "workflow-exit",
        WorkflowStepKind.Set => "workflow-set",
        _ => "workflow-module"
    };

    private string GetValue(string key, string fallback) => Step.Values.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value! : fallback;
    private Task SelectAsync() => OnSelected.InvokeAsync(Step);
    private Task RemoveAsync() => OnRemoved.InvokeAsync(Step);
    private Task AddChildAsync(bool elseBranch) => OnAddChild.InvokeAsync((Step, elseBranch));
}
