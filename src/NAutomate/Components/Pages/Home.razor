@page "/"

<PageTitle>NAutomate</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h2">NAutomate</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    Build, debug and run declarative automation flows.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" Href="/editor">
                Create project
            </MudButton>
        </MudStack>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Authentication is intentionally a stub for this phase. Recent projects are shown locally until the project store is introduced.
        </MudAlert>

        <MudText Typo="Typo.h5">Recent projects</MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Class="project-card">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Smartphone" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h6">Appium playground</MudText>
                                <MudText Typo="Typo.caption">Recently opened</MudText>
                            </div>
                        </MudStack>
                        <MudText Class="mt-4">
                            Mobile automation flow for exercising the Appium module against the future MAUI target.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Color="Color.Primary" Href="/editor">Open</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Class="project-card">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Color="Color.Secondary">
                                <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.h6">Hello World</MudText>
                                <MudText Typo="Typo.caption">Initial runtime workflow</MudText>
                            </div>
                        </MudStack>
                        <MudText Class="mt-4">
                            Minimal core.echo automation used to validate the runtime.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Color="Color.Primary" Href="/editor">Open</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>
