@page "/projects"

<PageTitle>Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Spacing="5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h2">Projects</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Recent automation projects.</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/editor">
                New project
            </MudButton>
        </MudStack>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Class="project-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Appium playground</MudText>
                        <MudText Typo="Typo.caption">Recently opened</MudText>
                        <MudText Class="mt-4">Mobile automation flow for exercising the Appium module.</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Color="Color.Primary" Href="/editor">Open editor</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudCard Class="project-card">
                    <MudCardContent>
                        <MudText Typo="Typo.h6">Hello World</MudText>
                        <MudText Typo="Typo.caption">Initial runtime workflow</MudText>
                        <MudText Class="mt-4">Minimal core.echo workflow.</MudText>
                    </MudCardContent>
                    <MudCardActions><MudButton Color="Color.Primary" Href="/editor">Open editor</MudButton></MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>
